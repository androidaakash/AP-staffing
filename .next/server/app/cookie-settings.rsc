ug","href":"#managing-your-preferences","children":"Managing Your Preferences"}]}],["$","li","Browser Controls",{"children":["$","a",null,{"className":"block hover:text-forest-deep transition-colors leading-snug","href":"#browser-controls","children":"Browser Controls"}]}],["$","li","Changes to This Policy",{"children":["$","a",null,{"className":"block hover:text-forest-deep transition-colors leading-snug","href":"#changes-to-this-policy","children":"Changes to This Policy"}]}],["$","li","Contact Us",{"children":["$","a",null,{"className":"block hover:text-forest-deep transition-colors leading-snug","href":"#contact-us","children":"Contact Us"}]}]]}]}],["$","div",null,{"className":"flex items-center gap-space-xs text-label-sm font-label-sm text-slate-text-muted border-t border-slate-border pt-space-md","children":[["$","span",null,{"aria-hidden":"true","className":"material-symbols-outlined text-[16px] text-forest-mid","children":"update"}],["$","span",null,{"children":["Last updated ","1 September 2025"]}]]}]]}]}],["$","div",null,{"className":"max-w-3xl space-y-space-2xl","children":[["$","p",null,{"className":"font-body-lg text-body-lg text-slate-text-muted leading-relaxed","children":"This Cookie Policy explains what cookies are, how Aakash AP Ltd uses them on this website, and how you can manage your preferences. We keep our use of cookies deliberately light: essential cookies for core functionality and, with your consent, analytics cookies that help us improve the site. For any questions, contact advisory@aakashap.com."}],["$","div",null,{"className":"flex items-center gap-space-xs text-label-sm font-label-sm text-slate-text-muted xl:hidden","children":[["$","span",null,{"aria-hidden":"true","className":"material-symbols-outlined text-[16px] text-forest-mid","children":"update"}],["$","span",null,{"children":["Last updated ","1 September 2025"]}]]}],[["$","section","What Are Cookies",{"className":"space-y-space-md scroll-mt-28","id":"what-are-cookies","children":[["$","h2",null,{"className":"font-headline-md text-headline-md text-forest-deep font-bold","children":"What Are Cookies"}],[["$","p","Cookies are small text files placed on your device when you visit a website. They are widely used to make websites work efficiently, remember your preferences, and provide information to the site owners about how the site is being used.",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"Cookies are small text files placed on your device when you visit a website. They are widely used to make websites work efficiently, remember your preferences, and provide information to the site owners about how the site is being used."}],["$","p","Some cookies are deleted when you close your browser, while others remain for a defined period. Similar technologies such as pixels and local storage operate in comparable ways and are covered by this policy alongside cookies.",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"Some cookies are deleted when you close your browser, while others remain for a defined period. Similar technologies such as pixels and local storage operate in comparable ways and are covered by this policy alongside cookies."}]],null]}],["$","section","How We Use Cookies",{"className":"space-y-space-md scroll-mt-28","id":"how-we-use-cookies","children":[["$","h2",null,{"className":"font-headline-md text-headline-md text-forest-deep font-bold","children":"How We Use Cookies"}],[["$","p","We use cookies to keep the website secure and functional, to remember your cookie preferences, and to understand in aggregate how visitors find and use our pages. This helps us improve navigation, content, and the overall experience for visitors, clients, and candidates.",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"We use cookies to keep the website secure and functional, to remember your cookie preferences, and to understand in aggregate how visitors find and use our pages. This helps us improve navigation, content, and the overall experience for visitors, clients, and candidates."}],["$","p","We do not use cookies to build advertising profiles of you, and we do not sell cookie data to third parties. Where analytics tools are used, data is aggregated and configured to minimise the collection of personally identifiable information.",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"We do not use cookies to build advertising profiles of you, and we do not sell cookie data to third parties. Where analytics tools are used, data is aggregated and configured to minimise the collection of personally identifiable information."}]],null]}],["$","section","Types of Cookies We Use",{"className":"space-y-space-md scroll-mt-28","id":"types-of-cookies-we-use","children":[["$","h2",null,{"className":"font-headline-md text-headline-md text-forest-deep font-bold","children":"Types of Cookies We Use"}],[["$","p","The cookies used on this website fall into the following categories:",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"The cookies used on this website fall into the following categories:"}]],["$","ul",null,{"className":"space-y-space-xs","children":[["$","li","Essential cookies: strictly necessary cookies that enable core functionality such as page navigation, security, load balancing, and remembering your consent choices. These cookies cannot be switched off through our preferences tool because the website cannot function properly without them.",{"className":"flex items-start gap-space-sm font-body-sm text-body-sm text-slate-text-muted","children":[["$","span",null,{"aria-hidden":"true","className":"material-symbols-outlined text-[18px] text-emerald-accent mt-0.5","children":"check_circle"}],["$","span",null,{"children":"Essential cookies: strictly necessary cookies that enable core functionality such as page navigation, security, load balancing, and remembering your consent choices. These cookies cannot be switched off through our preferences tool because the website cannot function properly without them."}]]}],["$","li","Analytics cookies: performance and analytics cookies that help us understand how visitors interact with the website by collecting information such as pages visited, time on page, and referral source. These cookies are set only after you provide consent and can be withdrawn at any time.",{"className":"flex items-start gap-space-sm font-body-sm text-body-sm text-slate-text-muted","children":[["$","span",null,{"aria-hidden":"true","className":"material-symbols-outlined text-[18px] text-emerald-accent mt-0.5","children":"check_circle"}],["$","span",null,{"children":"Analytics cookies: performance and analytics cookies that help us understand how visitors interact with the website by collecting information such as pages visited, time on page, and referral source. These cookies are set only after you provide consent and can be withdrawn at any time."}]]}]]}]]}],["$","section","Consent and Legal Basis",{"className":"space-y-space-md scroll-mt-28","id":"consent-and-legal-basis","children":[["$","h2",null,{"className":"font-headline-md text-headline-md text-forest-deep font-bold","children":"Consent and Legal Basis"}],[["$","p","When you first visit our website, a cookie banner allows you to accept or reject non-essential cookies before they are set. Essential cookies are placed on the basis of our legitimate interests in operating a secure, functional website, while analytics cookies rely on your consent under applicable privacy and electronic communications law.",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"When you first visit our website, a cookie banner allows you to accept or reject non-essential cookies before they are set. Essential cookies are placed on the basis of our legitimate interests in operating a secure, functional website, while analytics cookies rely on your consent under applicable privacy and electronic communications law."}],["$","p","You can withdraw or change your consent at any time using the cookie preferences tool accessible from the website footer, or by clearing cookies in your browser and revisiting the site to reset your choices.",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"You can withdraw or change your consent at any time using the cookie preferences tool accessible from the website footer, or by clearing cookies in your browser and revisiting the site to reset your choices."}]],null]}],["$","section","Managing Your Preferences",{"className":"space-y-space-md scroll-mt-28","id":"managing-your-preferences","children":[["$","h2",null,{"className":"font-headline-md text-headline-md text-forest-deep font-bold","children":"Managing Your Preferences"}],[["$","p","Our cookie preferences tool lets you toggle analytics cookies on or off independently of essential cookies. Your choice is stored in a small preference cookie so that we do not ask you on every visit, and it is refreshed if you clear your browser data.",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"Our cookie preferences tool lets you toggle analytics cookies on or off independently of essential cookies. Your choice is stored in a small preference cookie so that we do not ask you on every visit, and it is refreshed if you clear your browser data."}],["$","p","Withdrawing consent does not affect the lawfulness of any processing carried out before withdrawal. After you change your preferences, any previously set analytics cookies will be removed from your device where technically feasible.",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"Withdrawing consent does not affect the lawfulness of any processing carried out before withdrawal. After you change your preferences, any previously set analytics cookies will be removed from your device where technically feasible."}]],null]}],["$","section","Browser Controls",{"className":"space-y-space-md scroll-mt-28","id":"browser-controls","children":[["$","h2",null,{"className":"font-headline-md text-headline-md text-forest-deep font-bold","children":"Browser Controls"}],[["$","p","All major browsers allow you to view, block, and delete cookies through their settings. Blocking all cookies may affect the functionality of this and other websites, including the ability to remember your cookie preferences.",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"All major browsers allow you to view, block, and delete cookies through their settings. Blocking all cookies may affect the functionality of this and other websites, including the ability to remember your cookie preferences."}],["$","p","Analytics providers offer opt-out mechanisms for their measurement tools, and many browsers support Do Not Track signals or third-party tracking protection. Guidance on managing cookies is available in the help section of your chosen browser.",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"Analytics providers offer opt-out mechanisms for their measurement tools, and many browsers support Do Not Track signals or third-party tracking protection. Guidance on managing cookies is available in the help section of your chosen browser."}]],null]}],["$","section","Changes to This Policy",{"className":"space-y-space-md scroll-mt-28","id":"changes-to-this-policy","children":[["$","h2",null,{"className":"font-headline-md text-headline-md text-forest-deep font-bold","children":"Changes to This Policy"}],[["$","p","We may update this Cookie Policy from time to time to reflect changes in the technologies we use or in applicable law. The current version is always published on this page with the date of the last update shown at the top.",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"We may update this Cookie Policy from time to time to reflect changes in the technologies we use or in applicable law. The current version is always published on this page with the date of the last update shown at the top."}],["$","p","If we make material changes to the way we use cookies, we will refresh consent requests where required so that you can review and update your preferences.",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"If we make material changes to the way we use cookies, we will refresh consent requests where required so that you can review and update your preferences."}]],null]}],["$","section","Contact Us",{"className":"space-y-space-md scroll-mt-28","id":"contact-us","children":[["$","h2",null,{"className":"font-headline-md text-headline-md text-forest-deep font-bold","children":"Contact Us"}],[["$","p","If you have questions about our use of cookies or this policy, contact us at advisory@aakashap.com or by post at Aakash AP Ltd, London, United Kingdom. Further information about your privacy rights is available in our Privacy Policy.",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"If you have questions about our use of cookies or this policy, contact us at advisory@aakashap.com or by post at Aakash AP Ltd, London, United Kingdom. Further information about your privacy rights is available in our Privacy Policy."}]],null]}]]]}]]}]}]]],null],null]},["$","$L4",null,{"parallelRouterKey":"children","segmentPath":["children","cookie-settings","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined","styles":null}],null]},[["$","html",null,{"lang":"en","className":"scroll-smooth","children":[["
nterprise-grade governance is not an add-on at Aakash AP; it is the baseline. Here is exactly how we protect client data and what our engagements commit to."}]]}],["$","div",null,{"className":"pt-space-xs","children":["$","div",null,{"className":"flex flex-wrap items-center gap-space-sm","children":[["$","span","ISO 27001 aligned",{"className":"inline-flex items-center gap-space-xs px-space-sm py-1 rounded-full bg-surface-container-lowest/10 text-primary-fixed font-label-sm text-label-sm","children":[["$","span",null,{"aria-hidden":"true","className":"material-symbols-outlined text-[14px]","children":"verified_user"}],"ISO 27001 aligned"]}],["$","span","GDPR & SOC 2 compliant",{"className":"inline-flex items-center gap-space-xs px-space-sm py-1 rounded-full bg-surface-container-lowest/10 text-primary-fixed font-label-sm text-label-sm","children":[["$","span",null,{"aria-hidden":"true","className":"material-symbols-outlined text-[14px]","children":"security"}],"GDPR & SOC 2 compliant"]}],["$","span","Encrypted VDI delivery",{"className":"inline-flex items-center gap-space-xs px-space-sm py-1 rounded-full bg-surface-container-lowest/10 text-primary-fixed font-label-sm text-label-sm","children":[["$","span",null,{"aria-hidden":"true","className":"material-symbols-outlined text-[14px]","children":"desktop_windows"}],"Encrypted VDI delivery"]}],["$","span","99.5% uptime commitment",{"className":"inline-flex items-center gap-space-xs px-space-sm py-1 rounded-full bg-surface-container-lowest/10 text-primary-fixed font-label-sm text-label-sm","children":[["$","span",null,{"aria-hidden":"true","className":"material-symbols-outlined text-[14px]","children":"bolt"}],"99.5% uptime commitment"]}]]}]}]]}]]}],["$","section",null,{"className":"w-full py-space-3xl bg-surface","children":["$","div",null,{"className":"max-w-7xl mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop grid grid-cols-1 xl:grid-cols-[300px_1fr] gap-space-2xl","children":[["$","aside",null,{"className":"hidden xl:block","children":["$","div",null,{"className":"sticky top-28 space-y-space-lg","children":[["$","div",null,{"className":"font-label-caps text-label-caps uppercase text-forest-deep tracking-wider","children":"On this page"}],["$","nav",null,{"aria-label":"Security & Service Level Commitments sections","children":["$","ul",null,{"className":"space-y-1.5 font-body-sm text-body-sm text-slate-text-muted","children":[["$","li","Our Security Framework",{"children":["$","a",null,{"className":"block hover:text-forest-deep transition-colors leading-snug","href":"#our-security-framework","children":"Our Security Framework"}]}],["$","li","Certifications & Standards",{"children":["$","a",null,{"className":"block hover:text-forest-deep transition-colors leading-snug","href":"#certifications-standards","children":"Certifications & Standards"}]}],["$","li","Secure Delivery Infrastructure",{"children":["$","a",null,{"className":"block hover:text-forest-deep transition-colors leading-snug","href":"#secure-delivery-infrastructure","children":"Secure Delivery Infrastructure"}]}],["$","li","Zero-Local-Data Policy",{"children":["$","a",null,{"className":"block hover:text-forest-deep transition-colors leading-snug","href":"#zero-local-data-policy","children":"Zero-Local-Data Policy"}]}],["$","li","Physical Security & Access Control",{"children":["$","a",null,{"className":"block hover:text-forest-deep transition-colors leading-snug","href":"#physical-security-access-control","children":"Physical Security & Access Control"}]}],["$","li","Workforce Vetting & Training",{"children":["$","a",null,{"className":"block hover:text-forest-deep transition-colors leading-snug","href":"#workforce-vetting-training","children":"Workforce Vetting & Training"}]}],["$","li","Incident Response & Notification",{"children":["$","a",null,{"className":"block hover:text-forest-deep transition-colors leading-snug","href":"#incident-response-notification","children":"Incident Response & Notification"}]}],["$","li","Business Continuity & Disaster Recovery",{"children":["$","a",null,{"className":"block hover:text-forest-deep transition-colors leading-snug","href":"#business-continuity-disaster-recovery","children":"Business Continuity & Disaster Recovery"}]}],["$","li","Service Level Commitments",{"children":["$","a",null,{"className":"block hover:text-forest-deep transition-colors leading-snug","href":"#service-level-commitments","children":"Service Level Commitments"}]}],["$","li","Governance & Reporting",{"children":["$","a",null,{"className":"block hover:text-forest-deep transition-colors leading-snug","href":"#governance-reporting","children":"Governance & Reporting"}]}]]}]}],["$","div",null,{"className":"flex items-center gap-space-xs text-label-sm font-label-sm text-slate-text-muted border-t border-slate-border pt-space-md","children":[["$","span",null,{"aria-hidden":"true","className":"material-symbols-outlined text-[16px] text-forest-mid","children":"update"}],["$","span",null,{"children":["Last updated ","1 September 2025"]}]]}]]}]}],["$","div",null,{"className":"max-w-3xl space-y-space-2xl","children":[["$","p",null,{"className":"font-body-lg text-body-lg text-slate-text-muted leading-relaxed","children":"Security and service quality are the foundation of every Aakash AP engagement. This document summarises the standards we hold ourselves to across our offshore delivery centres, from ISO 27001-aligned governance and virtual desktop infrastructure to published service level commitments. Detailed auditing evidence and contractual schedules are available to clients on request via advisory@aakashap.com."}],["$","div",null,{"className":"flex items-center gap-space-xs text-label-sm font-label-sm text-slate-text-muted xl:hidden","children":[["$","span",null,{"aria-hidden":"true","className":"material-symbols-outlined text-[16px] text-forest-mid","children":"update"}],["$","span",null,{"children":["Last updated ","1 September 2025"]}]]}],[["$","section","Our Security Framework",{"className":"space-y-space-md scroll-mt-28","id":"our-security-framework","children":[["$","h2",null,{"className":"font-headline-md text-headline-md text-forest-deep font-bold","children":"Our Security Framework"}],[["$","p","Aakash AP Ltd operates a documented information security management system aligned to ISO 27001, covering governance, risk assessment, access control, supplier management, and continual improvement. Policies are reviewed at least annually and updated in response to changes in threat landscape, client requirements, and regulatory obligations.",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"Aakash AP Ltd operates a documented information security management system aligned to ISO 27001, covering governance, risk assessment, access control, supplier management, and continual improvement. Policies are reviewed at least annually and updated in response to changes in threat landscape, client requirements, and regulatory obligations."}],["$","p","An internal security committee meets monthly to review incidents, audit findings, and remediation progress, reporting to executive leadership. All delivery centres operate to the same baseline controls, with local procedures tailored only where jurisdiction-specific law requires.",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"An internal security committee meets monthly to review incidents, audit findings, and remediation progress, reporting to executive leadership. All delivery centres operate to the same baseline controls, with local procedures tailored only where jurisdiction-specific law requires."}]],null]}],["$","section","Certifications & Standards",{"className":"space-y-space-md scroll-mt-28","id":"certifications-standards","children":[["$","h2",null,{"className":"font-headline-md text-headline-md text-forest-deep font-bold","children":"Certifications & Standards"}],[["$","p","Our controls are designed for alignment with ISO 27001 and audited against SOC 2 Type II trust services criteria through independent third-party assessments. We maintain compliance programmes for the UK GDPR and EU GDPR, including records of processing, data protection impact assessments, and documented international transfer safeguards.",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"Our controls are designed for alignment with ISO 27001 and audited against SOC 2 Type II trust services criteria through independent third-party assessments. We maintain compliance programmes for the UK GDPR and EU GDPR, including records of processing, data protection impact assessments, and documented international transfer safeguards."}],["$","p","Clients may request our current audit reports, penetration test summaries, and insurance certificates under confidentiality. We also support client-led audits and due diligence questionnaires as part of onboarding and annual reviews.",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"Clients may request our current audit reports, penetration test summaries, and insurance certificates under confidentiality. We also support client-led audits and due diligence questionnaires as part of onboarding and annual reviews."}]],null]}],["$","section","Secure Delivery Infrastructure",{"className":"space-y-space-md scroll-mt-28","id":"secure-delivery-infrastructure","children":[["$","h2",null,{"className":"font-headline-md text-headline-md text-forest-deep font-bold","children":"Secure Delivery Infrastructure"}],[["$","p","All delivery work is performed on hardened virtual desktop infrastructure (VDI) hosted in controlled environments. Sessions run on thin clients with no local storage, and USB mass storage devices are blocked by default, with exceptions considered only where a client explicitly requires and approves a controlled alternative.",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"All delivery work is performed on hardened virtual desktop infrastructure (VDI) hosted in controlled environments. Sessions run on thin clients with no local storage, and USB mass storage devices are blocked by default, with exceptions considered only where a client explicitly requires and approves a controlled alternative."}],["$","p","Clipboard, file transfer, printing, and screen capture functions are subject to policy restrictions depending on client requirements, and all activity is logged to tamper-resistant audit trails. Endpoints are patched, centrally managed, and monitored for anomalous behaviour around the clock.",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"Clipboard, file transfer, printing, and screen capture functions are subject to policy restrictions depending on client requirements, and all activity is logged to tamper-resistant audit trails. Endpoints are patched, centrally managed, and monitored for anomalous behaviour around the clock."}]],null]}],["$","section","Zero-Local-Data Policy",{"className":"space-y-space-md scroll-mt-28","id":"zero-local-data-policy","children":[["$","h2",null,{"className":"font-headline-md text-headline-md text-forest-deep font-bold","children":"Zero-Local-Data Policy"}],[["$","p","Client and candidate data must never reside on local drives, personal devices, or removable media. Work product is created, stored, and transmitted exclusively within the client's approved systems or Aakash AP's access-controlled repositories, with encryption in transit and at rest.",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"Client and candidate data must never reside on local drives, personal devices, or removable media. Work product is created, stored, and transmitted exclusively within the client's approved systems or Aakash AP's access-controlled repositories, with encryption in transit and at rest."}],["$","p","Where clients provide systems such as Bullhorn, Vincere, or bespoke CRMs, access is provisioned through role-based permissions and multi-factor authentication. Offboarding is immediate: accounts, tokens, and device sessions are revoked within one business hour of a team member leaving an engagement.",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"Where clients provide systems such as Bullhorn, Vincere, or bespoke CRMs, access is provisioned through role-based permissions and multi-factor authentication. Offboarding is immediate: accounts, tokens, and device sessions are revoked within one business hour of a team member leaving an engagement."}]],null]}],["$","section","Physical Security & Access Control",{"className":"space-y-space-md scroll-mt-28","id":"physical-security-access-control","children":[["$","h2",null,{"className":"font-headline-md text-headline-md text-forest-deep font-bold","children":"Physical Security & Access Control"}],[["$","p","Delivery centres are protected by biometric access control, 24/7 CCTV coverage, visitor management procedures, and segregated production floors. Only vetted personnel with a documented business need receive access to production areas.",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"Delivery centres are protected by biometric access control, 24/7 CCTV coverage, visitor management procedures, and segregated production floors. Only vetted personnel with a documented business need receive access to production areas."}],["$","p","Clean desk and clear screen policies are enforced, with secure lock-up for any approved physical materials and shredding facilities on site. Physical access logs are retained and reviewed, and access rights are recertified quarterly.",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"Clean desk and clear screen policies are enforced, with secure lock-up for any approved physical materials and shredding facilities on site. Physical access logs are retained and reviewed, and access rights are recertified quarterly."}]],null]}],["$","section","Workforce Vetting & Training",{"className":"space-y-space-md scroll-mt-28","id":"workforce-vetting-training","children":[["$","h2",null,{"className":"font-headline-md text-headline-md text-forest-deep font-bold","children":"Workforce Vetting & Training"}],[["$","p","Every team member completes pre-employment screening proportionate to their role, including identity verification, criminal record checks where legally permissible, employment and education verification, and reference checks. All staff sign confidentiality and acceptable use agreements before accessing any client system.",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"Every team member completes pre-employment screening proportionate to their role, including identity verification, criminal record checks where legally permissible, employment and education verification, and reference checks. All staff sign confidentiality and acceptable use agreements before accessing any client system."}],["$","p","Onboarding includes security awareness training, and annual refresher training is mandatory for all delivery staff. Simulated phishing exercises and secure development or handling workshops run throughout the year, with completion tracked at the team level.",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"Onboarding includes security awareness training, and annual refresher training is mandatory for all delivery staff. Simulated phishing exercises and secure development or handling workshops run throughout the year, with completion tracked at the team level."}]],null]}],["$","section","Incident Response & Notification",{"className":"space-y-space-md scroll-mt-28","id":"incident-response-notification","children":[["$","h2",null,{"className":"font-headline-md text-headline-md text-forest-deep font-bold","children":"Incident Response & Notification"}],[["$","p","We maintain documented incident response playbooks covering detection, containment, eradication, recovery, and post-incident review, rehearsed through tabletop exercises at least twice a year. A 24/7 escalation path ensures security events reach the on-call response lead without delay.",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"We maintain documented incident response playbooks covering detection, containment, eradication, recovery, and post-incident review, rehearsed through tabletop exercises at least twice a year. A 24/7 escalation path ensures security events reach the on-call response lead without delay."}],["$","p","Clients will be notified within 24 hours of confirmation of a personal data breach affecting their data, with an initial impact assessment and followed by regular updates until resolution. A root-cause analysis and remediation report is provided within ten business days of incident closure.",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"Clients will be notified within 24 hours of confirmation of a personal data breach affecting their data, with an initial impact assessment and followed by regular updates until resolution. A root-cause analysis and remediation report is provided within ten business days of incident closure."}]],null]}],["$","section","Business Continuity & Disaster Recovery",{"className":"space-y-space-md scroll-mt-28","id":"business-continuity-disaster-recovery","children":[["$","h2",null,{"className":"font-headline-md text-headline-md text-forest-deep font-bold","children":"Business Continuity & Disaster Recovery"}],[["$","p","Each delivery centre operates redundant power and network connectivity, geographically separated backup facilities, and tested failover procedures. Our target recovery time objective (RTO) is four hours and the target recovery point objective (RPO) is one hour for critical delivery systems.",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"Each delivery centre operates redundant power and network connectivity, geographically separated backup facilities, and tested failover procedures. Our target recovery time objective (RTO) is four hours and the target recovery point objective (RPO) is one hour for critical delivery systems."}],["$","p","Business continuity and disaster recovery plans are reviewed at least annually and exercised through live failover tests. Results, lessons learned, and remediation actions are documented and shared with clients on request.",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"Business continuity and disaster recovery plans are reviewed at least annually and exercised through live failover tests. Results, lessons learned, and remediation actions are documented and shared with clients on request."}]],null]}],["$","section","Service Level Commitments",{"className":"space-y-space-md scroll-mt-28","id":"service-level-commitments","children":[["$","h2",null,{"className":"font-headline-md text-headline-md text-forest-deep font-bold","children":"Service Level Commitments"}],[["$","p","The following commitments apply as standard across managed engagements, with any client-specific variations documented in the applicable statement of work:",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"The following commitments apply as standard across managed engagements, with any client-specific variations documented in the applicable statement of work:"}]],["$","ul",null,{"className":"space-y-space-xs","children":[["$","li","Response time: acknowledgement of client queries and support requests within 4 business hours during agreed coverage windows.",{"className":"flex items-start gap-space-sm font-body-sm text-body-sm text-slate-text-muted","children":[["$","span",null,{"aria-hidden":"true","className":"material-symbols-outlined text-[18px] text-emerald-accent mt-0.5","children":"check_circle"}],["$","span",null,{"children":"Response time: acknowledgement of client queries and support requests within 4 business hours during agreed coverage windows."}]]}],["$","li","Platform uptime: 99.5% availability for Aakash AP-managed delivery systems, measured monthly, excluding pre-announced maintenance windows.",{"className":"flex items-start gap-space-sm font-body-sm text-body-sm text-slate-text-muted","children":[["$","span",null,{"aria-hidden":"true","className":"material-symbols-outlined text-[18px] text-emerald-accent mt-0.5","children":"check_circle"}],["$","span",null,{"children":"Platform uptime: 99.5% availability for Aakash AP-managed delivery systems, measured monthly, excluding pre-announced maintenance windows."}]]}],["$","li","Submission quality: at least 90% of shortlisted candidates meet the agreed brief on first submission, measured through client feedback and interview progression rates.",{"className":"flex items-start gap-space-sm font-body-sm text-body-sm text-slate-text-muted","children":[["$","span",null,{"aria-hidden":"true","className":"material-symbols-outlined text-[18px] text-emerald-accent mt-0.5","children":"check_circle"}],["$","span",null,{"children":"Submission quality: at least 90% of shortlisted candidates meet the agreed brief on first submission, measured through client feedback and interview progression rates."}]]}],["$","li","Incident notification: confirmed personal data breaches communicated to affected clients within 24 hours of confirmation, with follow-up reporting as described above.",{"className":"flex items-start gap-space-sm font-body-sm text-body-sm text-slate-text-muted","children":[["$","span",null,{"aria-hidden":"true","className":"material-symbols-outlined text-[18px] text-emerald-accent mt-0.5","children":"check_circle"}],["$","span",null,{"children":"Incident notification: confirmed personal data breaches communicated to affected clients within 24 hours of confirmation, with follow-up reporting as described above."}]]}],["$","li","Reporting: monthly performance dashboards covering service levels, delivery volumes, and quality metrics, reviewed in scheduled governance calls.",{"className":"flex items-start gap-space-sm font-body-sm text-body-sm text-slate-text-muted","children":[["$","span",null,{"aria-hidden":"true","className":"material-symbols-outlined text-[18px] text-emerald-accent mt-0.5","children":"check_circle"}],["$","span",null,{"children":"Reporting: monthly performance dashboards covering service levels, delivery volumes, and quality metrics, reviewed in scheduled governance calls."}]]}]]}]]}],["$","section","Governance & Reporting",{"className":"space-y-space-md scroll-mt-28","id":"governance-reporting","children":[["$","h2",null,{"className":"font-headline-md text-headline-md text-forest-deep font-bold","children":"Governance & Reporting"}],[["$","p","Every engagement operates under a governance cadence agreed at mobilisation, typically comprising weekly operational check-ins and quarterly strategic reviews. Service level performance, security metrics, and improvement plans are standing agenda items.",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"Every engagement operates under a governance cadence agreed at mobilisation, typically comprising weekly operational check-ins and quarterly strategic reviews. Service level performance, security metrics, and improvement plans are standing agenda items."}],["$","p","Clients receive an annual security attestation summary and may request reasonable access to audit information, subject to confidentiality and the protection of other clients' data. Where service levels fall below target, we provide a documented remediation plan with owners and timelines.",{"className":"font-body-md text-body-md text-slate-text-muted leading-relaxed","children":"Clients receive an annual security attestation summary and may request reasonable access to audit information, subject to confidentiality and the protection of other clients' data. Where service levels fall below target, we provide a documented remediation plan with owners and timelines."}]],null]}]]]}]]}]}]]],null],null]},["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","security-sla","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L4",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined","styles":null}],null]},[["$","html",null,{"lang":"en","className":"scroll-smooth","children":[["$","head",null,{"children":[["$","link",null,{"href":"https://fonts.googleapis.com","rel":"preconnect"}],["$","link",null,{"crossOrigin":"","href":"https://fonts.gstatic.com","rel":"preconnect"}],["$","link",null,{"href":"https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap","rel":"stylesheet"}],["$","link",null,{"href":"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap","rel":"stylesheet"}]]}],["$","body",null,{"className":"bg-surface font-body-md text-slate-text-main antialiased selection:bg-emerald-accent selection:text-on-primary","children":[["$","$L5",null,{"children":[["$","$L6",null,{}],["$","$L7",null,{}],["$","main",null,{"className":"w-full pt-20 bg-surface min-h-[calc(100vh-80px)]","children":["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","div",null,{"className":"page-transition","children":["$","$L4",null,{}]}],"templateStyles":[],"templateScripts":[],"notFound":[["$","title",null,{"children":"404: This page could not be found